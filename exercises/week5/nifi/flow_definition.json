{
  "format": "de-genesis-nifi-flow/v2",
  "name": "DE Genesis Week 5 - Promotion Ingestion v2",
  "nifiVersion": "1.27.0",
  "description": "Blueprint portable là nguồn cấu hình chuẩn. Script configure_nifi_flow.py tạo Parameter Context, Controller Service, processor và connection qua REST API NiFi.",
  "parameterContext": {
    "name": "week5-local",
    "description": "Cấu hình local của flow ingestion Promotion API tuần 5",
    "parameters": {
      "mock.api.url": "http://mock-api:8000",
      "airflow.api.url": "http://airflow-webserver:8080",
      "airflow.username": "admin",
      "airflow.password": null,
      "postgres.host": "postgres",
      "postgres.port": "5432",
      "postgres.database": "de_roadmap",
      "postgres.username": "de_user",
      "postgres.password": null,
      "api.page.size": "100",
      "api.max.pages": "10",
      "api.expected.records": "250"
    },
    "sensitiveParameters": [
      "airflow.password",
      "postgres.password"
    ]
  },
  "controllerServices": [
    {
      "id": "week5-json-reader",
      "name": "Week 5 JSON Reader",
      "type": "JsonTreeReader",
      "properties": {
        "schema-access-strategy": "infer-schema"
      }
    },
    {
      "id": "week5-postgres-pool",
      "name": "Week 5 PostgreSQL Pool",
      "type": "DBCPConnectionPool",
      "properties": {
        "Database Connection URL": "jdbc:postgresql://#{postgres.host}:#{postgres.port}/#{postgres.database}",
        "Database Driver Class Name": "org.postgresql.Driver",
        "Database Driver Location(s)": "/opt/nifi/nifi-current/lib/postgresql.jar",
        "Database User": "#{postgres.username}",
        "Password": "#{postgres.password}"
      }
    }
  ],
  "processors": [
    {
      "id": "generate-batch",
      "name": "01 - Tạo batch_id",
      "type": "GenerateFlowFile",
      "schedulingStrategy": "TIMER_DRIVEN",
      "schedulingPeriod": "1 hour",
      "properties": {
        "Custom Text": "{}",
        "batch_id": "${now():format('yyyyMMddHHmmss')}",
        "page": "1"
      },
      "autoTerminatedRelationships": []
    },
    {
      "id": "invoke-promotion-api",
      "name": "02 - Gọi Promotion API theo trang",
      "type": "InvokeHTTP",
      "properties": {
        "HTTP Method": "GET",
        "Remote URL": "#{mock.api.url}/api/v1/promotions?page=${page}&page_size=#{api.page.size}",
        "Connection Timeout": "5 sec",
        "Read Timeout": "10 sec",
        "Response Generation Required": "true"
      },
      "autoTerminatedRelationships": ["Original"]
    },
    {
      "id": "route-api-status",
      "name": "03 - Phân loại HTTP API",
      "type": "RouteOnAttribute",
      "properties": {
        "success": "${invokehttp.status.code:equals('200')}",
        "retryable": "${invokehttp.status.code:equals('429'):or(${invokehttp.status.code:startsWith('5')})}",
        "terminal": "${invokehttp.status.code:startsWith('4'):and(${invokehttp.status.code:equals('429'):not()})}"
      },
      "autoTerminatedRelationships": ["unmatched"]
    },
    {
      "id": "extract-pagination",
      "name": "04 - Đọc metadata phân trang",
      "type": "EvaluateJsonPath",
      "properties": {
        "Destination": "flowfile-attribute",
        "pagination.has_next": "$.pagination.has_next",
        "pagination.page": "$.pagination.page",
        "pagination.total": "$.pagination.total"
      },
      "autoTerminatedRelationships": ["unmatched"]
    },
    {
      "id": "route-page",
      "name": "05 - Tách nhánh record và trang kế tiếp",
      "type": "RouteOnAttribute",
      "properties": {
        "Routing Strategy": "Route to Property name",
        "records": "${literal('true'):equals('true')}",
        "next_page": "${pagination.has_next:equals('true'):and(${page:toNumber():lt(#{api.max.pages})})}",
        "complete": "${pagination.has_next:equals('false')}",
        "pagination_limit": "${pagination.has_next:equals('true'):and(${page:toNumber():ge(#{api.max.pages})})}"
      },
      "autoTerminatedRelationships": ["unmatched"]
    },
    {
      "id": "increment-page",
      "name": "06 - Tăng số trang",
      "type": "UpdateAttribute",
      "properties": {
        "page": "${page:toNumber():plus(1)}"
      },
      "autoTerminatedRelationships": []
    },
    {
      "id": "split-promotions",
      "name": "07 - Tách promotion records",
      "type": "SplitJson",
      "properties": {
        "JsonPath Expression": "$.data[*]"
      },
      "autoTerminatedRelationships": ["original"]
    },
    {
      "id": "extract-fields",
      "name": "08 - Trích xuất khóa và metadata",
      "type": "EvaluateJsonPath",
      "properties": {
        "Destination": "flowfile-attribute",
        "promotion_id": "$.promotion_id",
        "product_id": "$.product_id",
        "source_updated_at": "$.updated_at"
      },
      "autoTerminatedRelationships": ["unmatched"]
    },
    {
      "id": "hash-payload",
      "name": "09 - Tính SHA-256 payload",
      "type": "HashContent",
      "properties": {
        "Hash Algorithm": "SHA-256",
        "Hash Attribute Name": "payload_hash"
      },
      "removeProperties": ["Attribute Name", "Fail When Empty"],
      "autoTerminatedRelationships": []
    },
    {
      "id": "validate-record",
      "name": "10 - Kiểm tra khóa bắt buộc",
      "type": "RouteOnAttribute",
      "properties": {
        "Routing Strategy": "Route to Property name",
        "valid": "${promotion_id:isEmpty():not():and(${product_id:isEmpty():not()})}",
        "invalid": "${promotion_id:isEmpty():or(${product_id:isEmpty()})}",
        "invalid_audit": "${promotion_id:isEmpty():or(${product_id:isEmpty()})}"
      },
      "autoTerminatedRelationships": ["unmatched"]
    },
    {
      "id": "mark-valid",
      "name": "11a - Đánh dấu record hợp lệ",
      "type": "UpdateAttribute",
      "properties": {
        "record.valid": "true",
        "validation.error": ""
      },
      "autoTerminatedRelationships": []
    },
    {
      "id": "mark-invalid",
      "name": "11b - Đánh dấu record không hợp lệ",
      "type": "UpdateAttribute",
      "properties": {
        "record.valid": "false",
        "validation.error": "Thiếu promotion_id hoặc product_id"
      },
      "autoTerminatedRelationships": []
    },
    {
      "id": "prepare-valid-record",
      "name": "12a - Bổ sung metadata raw hợp lệ",
      "type": "JoltTransformJSON",
      "properties": {
        "Jolt Transformation DSL": "Chain",
        "Jolt Specification": "[{\"operation\":\"shift\",\"spec\":{\"*\":\"payload.&\",\"promotion_id\":\"promotion_id\",\"product_id\":\"product_id\",\"updated_at\":\"source_updated_at\"}},{\"operation\":\"default\",\"spec\":{\"batch_id\":\"${batch_id}\",\"source_system\":\"nifi\",\"payload_hash\":\"${payload_hash}\",\"is_valid\":true}}]"
      },
      "autoTerminatedRelationships": []
    },
    {
      "id": "prepare-invalid-record",
      "name": "12b - Bổ sung metadata raw không hợp lệ",
      "type": "JoltTransformJSON",
      "properties": {
        "Jolt Transformation DSL": "Chain",
        "Jolt Specification": "[{\"operation\":\"shift\",\"spec\":{\"*\":\"payload.&\",\"promotion_id\":\"promotion_id\",\"product_id\":\"product_id\",\"updated_at\":\"source_updated_at\"}},{\"operation\":\"default\",\"spec\":{\"batch_id\":\"${batch_id}\",\"source_system\":\"nifi\",\"payload_hash\":\"${payload_hash}\",\"is_valid\":false,\"validation_error\":\"Thiếu promotion_id hoặc product_id\"}}]"
      },
      "autoTerminatedRelationships": []
    },
    {
      "id": "put-raw-postgres",
      "name": "13 - Ghi week5_raw.promotions_nifi",
      "type": "PutDatabaseRecord",
      "maxRetries": 3,
      "properties": {
        "Record Reader": "week5-json-reader",
        "Database Connection Pooling Service": "week5-postgres-pool",
        "Database Type": "PostgreSQL",
        "Statement Type": "UPSERT",
        "Table Name": "promotions_nifi",
        "Schema Name": "week5_raw",
        "Update Keys": "batch_id,source_system,promotion_id,payload_hash",
        "Unmatched Column Behavior": "Ignore Unmatched Columns"
      },
      "autoTerminatedRelationships": []
    },
    {
      "id": "wait-batch-complete",
      "name": "14 - Gom đủ batch trước khi trigger",
      "type": "MergeContent",
      "properties": {
        "Merge Strategy": "Bin-Packing Algorithm",
        "Correlation Attribute Name": "batch_id",
        "Minimum Number of Entries": "#{api.expected.records}",
        "Maximum Number of Entries": "10000",
        "Max Bin Age": "30 sec"
      },
      "autoTerminatedRelationships": ["original"]
    },
    {
      "id": "build-airflow-trigger",
      "name": "15 - Tạo payload trigger Airflow",
      "type": "ReplaceText",
      "properties": {
        "Replacement Strategy": "Always Replace",
        "Replacement Value": "{\"dag_run_id\":\"nifi__${batch_id}\",\"conf\":{\"source_mode\":\"nifi\",\"batch_id\":\"${batch_id}\",\"raw_table\":\"week5_raw.promotions_nifi\",\"source_count\":${pagination.total}}}"
      },
      "autoTerminatedRelationships": []
    },
    {
      "id": "trigger-airflow",
      "name": "16 - Trigger Airflow REST API",
      "type": "InvokeHTTP",
      "maxRetries": 3,
      "properties": {
        "HTTP Method": "POST",
        "Remote URL": "#{airflow.api.url}/api/v1/dags/de_genesis_week5_nifi_downstream/dagRuns",
        "Request Content-Type": "application/json",
        "Request Username": "#{airflow.username}",
        "Request Password": "#{airflow.password}",
        "Connection Timeout": "5 sec",
        "Read Timeout": "10 sec"
      },
      "autoTerminatedRelationships": ["Original"]
    },
    {
      "id": "route-airflow-status",
      "name": "17 - Phân loại kết quả trigger",
      "type": "RouteOnAttribute",
      "properties": {
        "triggered": "${invokehttp.status.code:equals('200'):or(${invokehttp.status.code:equals('201')})}",
        "duplicate": "${invokehttp.status.code:equals('409')}",
        "unauthorized": "${invokehttp.status.code:equals('401')}",
        "retryable": "${invokehttp.status.code:equals('429'):or(${invokehttp.status.code:startsWith('5')})}",
        "terminal": "${invokehttp.status.code:startsWith('4'):and(${invokehttp.status.code:equals('401'):not()}):and(${invokehttp.status.code:equals('409'):not()})}"
      },
      "autoTerminatedRelationships": ["unmatched"]
    },
    {
      "id": "audit-terminal",
      "name": "90 - Audit lỗi terminal",
      "type": "LogAttribute",
      "properties": {
        "Log Level": "error",
        "Log Payload": "true"
      },
      "autoTerminatedRelationships": ["success"]
    },
    {
      "id": "audit-success",
      "name": "91 - Audit thành công hoặc trùng",
      "type": "LogAttribute",
      "properties": {
        "Log Level": "info",
        "Log Payload": "false"
      },
      "autoTerminatedRelationships": ["success"]
    }
  ],
  "connections": [
    ["generate-batch", "success", "invoke-promotion-api"],
    ["invoke-promotion-api", "Response", "route-api-status"],
    ["invoke-promotion-api", "Retry", "invoke-promotion-api"],
    ["invoke-promotion-api", "Failure", "audit-terminal"],
    ["invoke-promotion-api", "No Retry", "audit-terminal"],
    ["route-api-status", "success", "extract-pagination"],
    ["route-api-status", "retryable", "invoke-promotion-api"],
    ["route-api-status", "terminal", "audit-terminal"],
    ["extract-pagination", "matched", "route-page"],
    ["extract-pagination", "failure", "audit-terminal"],
    ["route-page", "records", "split-promotions"],
    ["route-page", "next_page", "increment-page"],
    ["route-page", "complete", "audit-success"],
    ["route-page", "pagination_limit", "audit-terminal"],
    ["increment-page", "success", "invoke-promotion-api"],
    ["split-promotions", "split", "extract-fields"],
    ["split-promotions", "failure", "audit-terminal"],
    ["extract-fields", "matched", "hash-payload"],
    ["extract-fields", "failure", "audit-terminal"],
    ["hash-payload", "success", "validate-record"],
    ["hash-payload", "failure", "audit-terminal"],
    ["validate-record", "valid", "mark-valid"],
    ["validate-record", "invalid", "mark-invalid"],
    ["validate-record", "invalid_audit", "audit-terminal"],
    ["mark-valid", "success", "prepare-valid-record"],
    ["mark-invalid", "success", "prepare-invalid-record"],
    ["prepare-valid-record", "success", "put-raw-postgres"],
    ["prepare-valid-record", "failure", "audit-terminal"],
    ["prepare-invalid-record", "success", "put-raw-postgres"],
    ["prepare-invalid-record", "failure", "audit-terminal"],
    ["put-raw-postgres", "success", "wait-batch-complete"],
    ["put-raw-postgres", "retry", "put-raw-postgres"],
    ["put-raw-postgres", "failure", "audit-terminal"],
    ["wait-batch-complete", "merged", "build-airflow-trigger"],
    ["wait-batch-complete", "failure", "audit-terminal"],
    ["build-airflow-trigger", "success", "trigger-airflow"],
    ["build-airflow-trigger", "failure", "audit-terminal"],
    ["trigger-airflow", "Response", "route-airflow-status"],
    ["trigger-airflow", "Retry", "trigger-airflow"],
    ["trigger-airflow", "Failure", "audit-terminal"],
    ["trigger-airflow", "No Retry", "audit-terminal"],
    ["route-airflow-status", "triggered", "audit-success"],
    ["route-airflow-status", "duplicate", "audit-success"],
    ["route-airflow-status", "unauthorized", "audit-terminal"],
    ["route-airflow-status", "retryable", "trigger-airflow"],
    ["route-airflow-status", "terminal", "audit-terminal"]
  ],
  "relationshipContract": {
    "generate-batch": ["success"],
    "invoke-promotion-api": ["Original", "Response", "Retry", "No Retry", "Failure"],
    "route-api-status": ["success", "retryable", "terminal", "unmatched"],
    "extract-pagination": ["matched", "unmatched", "failure"],
    "route-page": ["records", "next_page", "complete", "pagination_limit", "unmatched"],
    "increment-page": ["success"],
    "split-promotions": ["split", "original", "failure"],
    "extract-fields": ["matched", "unmatched", "failure"],
    "hash-payload": ["success", "failure"],
    "validate-record": ["valid", "invalid", "invalid_audit", "unmatched"],
    "mark-valid": ["success"],
    "mark-invalid": ["success"],
    "prepare-valid-record": ["success", "failure"],
    "prepare-invalid-record": ["success", "failure"],
    "put-raw-postgres": ["success", "retry", "failure"],
    "wait-batch-complete": ["merged", "original", "failure"],
    "build-airflow-trigger": ["success", "failure"],
    "trigger-airflow": ["Original", "Response", "Retry", "No Retry", "Failure"],
    "route-airflow-status": ["triggered", "duplicate", "unauthorized", "retryable", "terminal", "unmatched"],
    "audit-terminal": ["success"],
    "audit-success": ["success"]
  },
  "failureQueues": [
    "api-terminal-error",
    "pagination-limit",
    "invalid-record",
    "database-failure",
    "airflow-unauthorized",
    "airflow-terminal-error"
  ]
}
